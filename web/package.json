{
  "name": "fufu-toolbox",
  "private": true,
  "version": "26.1.4",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "postbuild": "node scripts/package-model.mjs && node scripts/package-offline.mjs",
    "model:download": "node scripts/download-model.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "prebuild:esa": "node scripts/install-esa.mjs",
    "build:esa": "npm run build && node scripts/package-esa.mjs && node scripts/check-pages.mjs --esa",
    "pages:check": "node scripts/check-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:model": "node scripts/test-model.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@ffmpeg/core": "0.12.10",
    "@fluentui/react-components": "^9.75.2",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@material/web": "^2.5.0",
    "@mediabunny/flac-encoder": "^1.66.0",
    "@mediabunny/mp3-encoder": "^1.66.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.21.0",
    "@tensorflow/tfjs-backend-wasm": "^3.21.0",
    "@tonejs/midi": "^2.0.28",
    "@zip.js/zip.js": "^2.25.0",
    "ajv": "^8.20.0",
    "docx": "^9.15.4",
    "docx-preview": "^0.4.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.554.0",
    "mediabunny": "^1.66.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
